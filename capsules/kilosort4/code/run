#!/usr/bin/env bash
set -ex

# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.
export KILOSORT_LOCAL_DOWNLOADS_PATH="$(pwd -P)/.kilosort-downloads"
python -u prepare_templates.py --cache-dir "$KILOSORT_LOCAL_DOWNLOADS_PATH"
python -u run_capsule.py "$@"
