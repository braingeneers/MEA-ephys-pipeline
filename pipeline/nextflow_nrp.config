// NRP: the driver and every task run as finite Kubernetes Jobs on one RWX PVC.
plugins { id 'nf-k8s@1.5.4' }

params.executor = 'k8s'
params.publish_overwrite = true
params.k8s_namespace = System.getenv('TEST_NAMESPACE') ?: 'braingeneers'
params.k8s_storage_claim = System.getenv('TEST_PVC')
params.test_id = System.getenv('TEST_ID') ?: 'mea-nrp'
params.k8s_exclude_nodes = (System.getenv('TEST_EXCLUDE_NODES') ?: '').tokenize(',')
// Optional shared decoder for Maxwell raw files and Maxwell-compressed NWBs.
params.nrp_hdf5_plugin_path = null
// Override resource fields by process name in an additional NRP config.
params.nrp_resources = [:]

docker.enabled = false
shifter.enabled = false
executor.queueSize = 2
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,cpus,memory,container'

process {
    executor = 'k8s'
    cpus = { task_settings.resources?.cpus ?: params.nrp_resources[task.process.tokenize(':').last()]?.cpus ?: 1 }
    memory = { task_settings.resources?.memory ?: params.nrp_resources[task.process.tokenize(':').last()]?.memory ?: '2 GB' }
    disk = { task_settings.resources?.disk ?: params.nrp_resources[task.process.tokenize(':').last()]?.disk ?: '4 GB' }  // Equal requests/limits.
    time = { task_settings.resources?.time ?: params.nrp_resources[task.process.tokenize(':').last()]?.time ?: '30 min' }
    errorStrategy = 'terminate'
    maxRetries = 0

    // Kubernetes runs this hook inside each task container. Keep NRP's CPU
    // policy here so the NERSC/local launch paths retain their own environment.
    beforeScript = {
        def plugin = params.nrp_hdf5_plugin_path ?
            "export HDF5_PLUGIN_PATH='${params.nrp_hdf5_plugin_path.toString().replace("'", "'\\''")}'\n" : ''
        plugin + """
        export CO_CPUS=${task.cpus} N_JOBS_EXT=${task.cpus}
        export OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus}
        export MKL_NUM_THREADS=${task.cpus} NUMBA_NUM_THREADS=${task.cpus}
        """.stripIndent()
    }

    container = 'braingeneers/mea-ephys-base:0.1.0'
    withName: 'job_dispatch|preprocessing|postprocessing|curation|visualization|results_collector|burst_detection|bundle_stage|verify_stage' {
        container = { task_settings.container }
    }
    withName: report_generation {
        container = { task_settings.container }
    }
    withName: 'preprocessing|spikesort_kilosort4' {
        cpus = { task_settings.resources?.cpus ?: params.nrp_resources[task.process.tokenize(':').last()]?.cpus ?: 4 }
        memory = { task_settings.resources?.memory ?: params.nrp_resources[task.process.tokenize(':').last()]?.memory ?: '8 GB' }
        time = { task_settings.resources?.time ?: params.nrp_resources[task.process.tokenize(':').last()]?.time ?: '60 min' }
    }
    withName: 'postprocessing|curation|visualization|nwb_ecephys|nwb_units' {
        cpus = { task_settings.resources?.cpus ?: params.nrp_resources[task.process.tokenize(':').last()]?.cpus ?: 2 }
        memory = { task_settings.resources?.memory ?: params.nrp_resources[task.process.tokenize(':').last()]?.memory ?: '8 GB' }
    }
    withName: spikesort_kilosort4 {
        memory = { task_settings.resources?.memory ?: params.nrp_resources[task.process.tokenize(':').last()]?.memory ?: '4 GB' }  // 32-channel fixture default.
        container = { task_settings.container }
        // Keep one selector: a profile's same-name selector replaces this block.
        accelerator = { task_settings.torch_device == 'cuda' ? [request: 1, limit: 1] : null }
        pod = { task_settings.torch_device == 'cuda' ?
            [[toleration: [key: 'nvidia.com/gpu', operator: 'Exists', effect: 'PreferNoSchedule']]] : [] }
    }
    withName: 'nwb_ecephys|nwb_units' {
        container = { task_settings.container }
    }
}

k8s {
    pod = [
        [automountServiceAccountToken: false],
        [env: 'HOME', value: '/tmp'],
        [env: 'MPLBACKEND', value: 'Agg'],
        [env: 'PYTHONUNBUFFERED', value: '1'],
        [label: 'mea-test', value: params.test_id],
        [ttlSecondsAfterFinished: 86400]
    ] + (params.k8s_exclude_nodes ? [[affinity: [nodeAffinity: [requiredDuringSchedulingIgnoredDuringExecution: [
        nodeSelectorTerms: [[matchExpressions: [[key: 'kubernetes.io/hostname', operator: 'NotIn', values: params.k8s_exclude_nodes]]]]
    ]]]]] : [])
    namespace = params.k8s_namespace
    serviceAccount = 'nextflow-sa'
    storageClaimName = params.k8s_storage_claim
    storageMountPath = '/workspace'
    computeResourceType = 'Job'
    cpuLimits = true
    cleanup = false
    debug.yaml = true
    securityContext = [runAsUser: 1000, runAsGroup: 100, fsGroup: 100]
    client {
        server = 'https://kubernetes.default.svc'
        tokenFile = '/var/run/secrets/kubernetes.io/serviceaccount/token'
        sslCertFile = '/var/run/secrets/kubernetes.io/serviceaccount/ca.crt'
        verifySsl = true
    }
}

profiles {
    cpu {
        params.torch_device = 'cpu'
    }
    gpu {
        params.torch_device = 'cuda'
    }
}
