manifest {
    name = 'braingeneers-modular-maxwell-to-nwb'
    description = 'Owned Maxwell scientific runtime for native modular NWB conversion.'
    version = '0.1.21'
    nextflowVersion = '>=26.04.6'
}
params {
    artifacts = ''
    recordings = []
    settings = [:]
    output_uri = ''
    collection_uri = ''
    cache_uri = ''
    run_id = ''
    step_id = 'convert'
    local_bind_paths = []
    public_reader_endpoint = ''
    minimum_disk_gib = 0
}
includeConfig 'components/common/runtime.config'
process.ext.workflow_group = 'Data Processing'
