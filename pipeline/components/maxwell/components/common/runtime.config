// Deployment only. Image, resources, retries and scientific settings belong to tasks.
plugins {
    id 'nf-k8s@1.5.4'
}
manifest.nextflowVersion = '!26.04.6'
workflow.failOnIgnore = true

params {
    s3_endpoint = ''
    aws_profile = ''
    kube_context = ''
    k8s_namespace = 'default'
    k8s_service_account = 'default'
    k8s_storage_claim = ''
    k8s_storage_mount_path = '/workspace'
    k8s_storage_sub_path = ''
    k8s_cleanup = true
    k8s_job_ttl_seconds = 10800
    k8s_aws_secret_name = ''
    k8s_aws_access_key_id_key = 'AWS_ACCESS_KEY_ID'
    k8s_aws_secret_access_key_key = 'AWS_SECRET_ACCESS_KEY'
    k8s_aws_session_token_key = 'AWS_SESSION_TOKEN'
    require_k8s_aws_secret_name = false
    k8s_run_node_hostnames = ''
    k8s_image_pull_policy = ''
    task_queue_size = 4
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
}
executor.queueSize = params.task_queue_size
docker.enabled = false

report { enabled = true; file = 'report.html'; overwrite = true }
timeline { enabled = true; file = 'timeline.html'; overwrite = true }
trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
    fields = 'task_id,hash,name,status,exit,attempt,start,complete,duration,realtime,cpus,memory,disk,peak_rss,%cpu,workdir'
}
dag { enabled = true; file = 'dag.html'; overwrite = true }

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
    }
    k8s {
        process.executor = 'k8s'
        process.scratch = '/scratch'
        // nextflow run uses the global workDir; launcher -work-dir still wins.
        workDir = "${params.k8s_storage_mount_path}/work"
        k8s {
            context = params.kube_context ?: null
            namespace = params.k8s_namespace
            serviceAccount = params.k8s_service_account
            storageClaimName = params.k8s_storage_claim
            storageMountPath = params.k8s_storage_mount_path
            storageSubPath = params.k8s_storage_sub_path ?: null
            cpuLimits = true
            cleanup = params.k8s_cleanup
            computeResourceType = 'Job'
            pod = [
                [ttlSecondsAfterFinished: params.k8s_job_ttl_seconds as Integer],
                [emptyDir: [:], mountPath: '/scratch'],
                [env: 'PYTHONUNBUFFERED', value: 'true'],
            ] + (params.k8s_image_pull_policy ? [[imagePullPolicy: params.k8s_image_pull_policy]] : []) + (
                params.k8s_run_node_hostnames ? [[affinity: [nodeAffinity: [
                    requiredDuringSchedulingIgnoredDuringExecution: [nodeSelectorTerms: [[matchExpressions: [[
                        key: 'kubernetes.io/hostname', operator: 'In',
                        values: params.k8s_run_node_hostnames instanceof Collection
                            ? params.k8s_run_node_hostnames.collect { it.toString().trim() }.findAll { it }
                            : params.k8s_run_node_hostnames.toString().split(',').collect { it.trim() }.findAll { it },
                    ]]]]
                ]]]]] : []
            )
        }
    }
    k8s_aws_secret {
        params.require_k8s_aws_secret_name = true
        process.pod = [
            [env: 'AWS_ACCESS_KEY_ID', secret: "${params.k8s_aws_secret_name}/${params.k8s_aws_access_key_id_key}"],
            [env: 'AWS_SECRET_ACCESS_KEY', secret: "${params.k8s_aws_secret_name}/${params.k8s_aws_secret_access_key_key}"],
        ]
    }
    k8s_aws_session_secret {
        params.require_k8s_aws_secret_name = true
        process.pod = [
            [env: 'AWS_ACCESS_KEY_ID', secret: "${params.k8s_aws_secret_name}/${params.k8s_aws_access_key_id_key}"],
            [env: 'AWS_SECRET_ACCESS_KEY', secret: "${params.k8s_aws_secret_name}/${params.k8s_aws_secret_access_key_key}"],
            [env: 'AWS_SESSION_TOKEN', secret: "${params.k8s_aws_secret_name}/${params.k8s_aws_session_token_key}"],
        ]
    }
}
