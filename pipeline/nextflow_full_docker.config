// One local deployment for the raw-capable NF26 caller. Native process policy
// stays with the converter; MEA selectors apply only to its scientific processes.
includeConfig 'nextflow_conversion.config'

params.executor = 'local'
params.n_jobs = 2
process {
    withName: 'job_dispatch|preprocessing|spikesort_kilosort4|postprocessing|curation|visualization|results_collector|report_generation|burst_detection|nwb_ecephys|nwb_units|bundle_stage|verify_stage' {
        executor = 'local'
        container = { task_settings.container }
        cpus = { task_settings.resources?.cpus ?: 2 }
        memory = { task_settings.resources?.memory ?: '8 GB' }
        time = { task_settings.resources?.time ?: '60 min' }
        errorStrategy = 'terminate'
        maxRetries = 0
        containerOptions = '--user 1000:1000 -e HOME=/tmp -e MPLBACKEND=Agg'
        beforeScript = {
            "export CO_CPUS=${task.cpus} N_JOBS_EXT=${task.cpus} OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus} NUMBA_NUM_THREADS=${task.cpus}"
        }
    }
    withName: spikesort_kilosort4 {
        accelerator = { task_settings.torch_device == 'cuda' ? [request:1,limit:1] : null }
    }
}
docker.enabled = true
docker.envWhitelist = ['CO_CPUS','N_JOBS_EXT','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMBA_NUM_THREADS']
