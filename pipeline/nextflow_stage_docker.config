// Portable local Docker execution. NERSC and Kubernetes remain separate configs.
params.executor = 'local'
params.n_jobs = 2
process {
    executor = 'local'
    cpus = { task_settings.resources?.cpus ?: 2 }
    memory = { task_settings.resources?.memory ?: '8 GB' }
    time = { task_settings.resources?.time ?: '60 min' }
    errorStrategy = 'terminate'
    maxRetries = 0
    beforeScript = {
        "export CO_CPUS=${task.cpus} N_JOBS_EXT=${task.cpus} OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus} NUMBA_NUM_THREADS=${task.cpus}"
    }
    withName: 'job_dispatch|preprocessing|postprocessing|curation|visualization|results_collector|burst_detection|bundle_stage|verify_stage' {
        container = 'ghcr.io/allenneuraldynamics/aind-ephys-pipeline-base@sha256:a9728fa63078b0429e4c85b5918d7286d4c3f6ed5def900f9876540513adec03'
    }
    withName: spikesort_kilosort4 {
        container = 'ghcr.io/allenneuraldynamics/aind-ephys-spikesort-kilosort4@sha256:b5192e8b2b4f62f07b98ed693f23a192dff04c119e744946ac000589026b8165'
        accelerator = { task_settings.torch_device == 'cuda' ? [request:1,limit:1] : null }
    }
    withName: 'nwb_ecephys|nwb_units' {
        container = 'ghcr.io/allenneuraldynamics/aind-ephys-pipeline-nwb@sha256:03ad8e8572ad1e98da9d35c380e8fad23de895731d2d382fd9e18376dd61ab4b'
    }
    withName: report_generation { container = { task_settings.container } }
}
docker.enabled = true
docker.runOptions = '--user 1000:1000 -e HOME=/tmp -e MPLBACKEND=Agg'
docker.envWhitelist = ['CO_CPUS','N_JOBS_EXT','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMBA_NUM_THREADS']
trace.fields = 'task_id,hash,name,status,exit,submit,start,complete,realtime,cpus,memory,container'
